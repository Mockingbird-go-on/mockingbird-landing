---
import "../styles/articles.css";
import { articles, articlesEn, articlePath } from "../articles";
import type { Locale } from "../i18n";

export interface Props {
  title: string;
  description?: string;
  date?: string;
  readingTime?: string;
  tag?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  locale?: Locale;
}

const { title, description, date, readingTime, tag, jsonLd, locale = "ru" } = Astro.props;
const lang = locale === "en" ? "en" : "ru";

const pathname = Astro.url.pathname.replace(/\/+$/, "") || "/articles";
const canonical = new URL(pathname + "/", Astro.site).href;

/* OG-картинки по слагу статьи */
const currentSlug = pathname.replace(/^\/articles(\/en)?\/?/, "").replace(/\/$/, "");
const slugList = locale === "en" ? articlesEn : articles;
const ogImage = new URL(
  currentSlug && (currentSlug === "questions" || slugList.some((a) => a.slug === currentSlug))
    ? `/assets/img/og/${currentSlug}.jpg`
    : "/assets/img/og.jpg",
  Astro.site
).href;

const isArticle = currentSlug !== "" && slugList.some((a) => a.slug === currentSlug);

/* пары RU ↔ EN для hreflang и переключателя */
const isEn = locale === "en";
const altPath = isEn
  ? pathname.replace(/^\/articles\/en/, "/articles")
  : pathname.replace(/^\/articles/, "/articles/en");
const altExists = isEn
  ? articles.some((a) => a.slug === currentSlug) || currentSlug === "" || currentSlug === "questions"
  : articlesEn.some((a) => a.slug === currentSlug) || currentSlug === "" || currentSlug === "questions";
const altCanonical = altExists ? new URL(altPath.replace(/\/+$/, "") + "/", Astro.site).href : undefined;

/* автоперенос на язык браузера при первом визите, выбор сохраняется */
const langRedirect = `
(function(){try{
  if(localStorage.getItem('mb-lang'))return;
  var pref=(navigator.language||'').toLowerCase().startsWith('en')?'en':'ru';
  if(pref==='${locale}')return;
  var base=location.pathname.replace(/\\/+$/,'');
  var target = base${isEn ? ".replace(/\\/en$/,'') + '/'" : " + '/en/'"};
  location.replace(target);
}catch(e){}})();`;

const breadcrumbLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Mockingbird", item: new URL("/", Astro.site).href },
    { "@type": "ListItem", position: 2, name: isEn ? "Articles" : "Статьи", item: new URL(isEn ? "/articles/en/" : "/articles/", Astro.site).href },
    ...(isArticle || currentSlug === "questions"
      ? [{ "@type": "ListItem", position: 3, name: title }]
      : []),
  ],
};

/* сущности сайта: связаны с Organization на главной через @id */
const graphLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": "https://mocking.ru/#org",
      name: "Mockingbird",
      url: "https://mocking.ru/",
      logo: "https://mocking.ru/assets/img/logo.png",
      sameAs: [
        "https://github.com/Mockingbird-go-on/mockingbird",
        "https://t.me/MOCKINGBird_release",
      ],
    },
    {
      "@type": "WebSite",
      "@id": isEn ? "https://mocking.ru/en/#website" : "https://mocking.ru/#website",
      url: isEn ? "https://mocking.ru/en/" : "https://mocking.ru/",
      name: "Mockingbird",
      inLanguage: isEn ? "en-US" : "ru-RU",
      publisher: { "@id": "https://mocking.ru/#org" },
    },
  ],
};

const switchLang = isEn ? "ru" : "en";
const switchOnclick = `try{localStorage.setItem('mb-lang','${switchLang}')}catch(e){}`;

const extraLd = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];

const T = {
  ru: { articlesLabel: "статьи", toMain: "на главную ↗", docs: "docs ↗", allArticles: "все статьи", navTitle: "Статьи", questionsLink: "Вопросы и ответы", releases: "релизы", langSwitch: "EN" },
  en: { articlesLabel: "articles", toMain: "home ↗", docs: "docs ↗", allArticles: "all articles", navTitle: "Articles", questionsLink: "Questions & answers", releases: "releases", langSwitch: "RU" },
}[locale];
---

<!DOCTYPE html>
<html lang={lang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title} — Mockingbird</title>
  {description && <meta name="description" content={description} />}
  <meta name="robots" content="index, follow, max-image-preview:large" />
  <link rel="canonical" href={canonical} />
  {altCanonical && <link rel="alternate" hreflang={isEn ? "ru" : "en"} href={altCanonical} />}
  {altCanonical && <link rel="alternate" hreflang="x-default" href={isEn ? altCanonical : canonical} />}
  <link rel="icon" type="image/png" href="/assets/img/favicon.png" />

  <meta property="og:type" content={isArticle ? "article" : "website"} />
  <meta property="og:site_name" content="Mockingbird" />
  <meta property="og:title" content={title} />
  {description && <meta property="og:description" content={description} />}
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:locale" content={isEn ? "en_US" : "ru_RU"} />
  {date && <meta property="article:published_time" content={date} />}

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  {description && <meta name="twitter:description" content={description} />}
  <meta name="twitter:image" content={ogImage} />

  <link rel="preload" href="/assets/fonts/Inter-400-cyrillic.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/assets/fonts/Kholodos.woff2" as="font" type="font/woff2" crossorigin />

  {altExists && <script set:html={langRedirect} />}

  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(graphLd)} />
  {extraLd.map((ld) => <script type="application/ld+json" set:html={JSON.stringify(ld)} />)}
</head>
<body>
  <header class="art-header">
    <a class="art-header__brand" href={isEn ? "/en/" : "/"}>
      <img src="/assets/img/logo.png" alt="" />
      <span class="art-header__name"><b>M</b>ockingbird</span>
    </a>
    <span class="art-header__docs">{T.articlesLabel}</span>
    <nav class="art-header__nav">
      {altExists && <a class="art-header__lang" href={altPath.replace(/\/+$/, "") + "/"} onclick={switchOnclick} title={isEn ? "Перейти на русский" : "Switch to English"}>{T.langSwitch}</a>}
      <a class="art-header__link" href={isEn ? "/en/" : "/"}>{T.toMain}</a>
      <a class="art-header__link" href={isEn ? "/docs/en/" : "/docs/"}>{T.docs}</a>
      <a class="art-header__cta" href={isEn ? "/articles/en/" : "/articles/"}>{T.allArticles}</a>
    </nav>
  </header>

  <div class="art-shell">
    <aside class="art-nav">
      <span class="art-nav__title">{T.navTitle}</span>
      <ul>
        <li>
          <a href={isEn ? "/articles/en/questions/" : "/articles/questions/"} class={currentSlug === "questions" ? "is-active" : ""}>{T.questionsLink}</a>
        </li>
        {slugList.map((a) => (
          <li>
            <a href={articlePath(a.slug, locale)} class={isArticle && a.slug === currentSlug ? "is-active" : ""}>{a.title}</a>
          </li>
        ))}
      </ul>
    </aside>

    <main class="art-content">
      <slot />

      <footer class="art-footer">
        <span>© {new Date().getFullYear()} mockingbird</span>
        <span>
          <a href="https://github.com/Mockingbird-go-on/mockingbird/releases">{T.releases}</a> ·
          <a href="https://t.me/MOCKINGBird_release">telegram{isEn ? " (Russian)" : ""}</a>
        </span>
      </footer>
    </main>
  </div>
</body>
</html>
