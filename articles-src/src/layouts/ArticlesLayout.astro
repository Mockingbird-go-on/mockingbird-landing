---
import "../styles/articles.css";
import { articles, articlePath } from "../articles";

export interface Props {
  title: string;
  description?: string;
  date?: string;
  readingTime?: string;
  tag?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const { title, description, date, readingTime, tag, jsonLd } = Astro.props;

const pathname = Astro.url.pathname.replace(/\/+$/, "") || "/articles";
const canonical = new URL(pathname + "/", Astro.site).href;
const ogImage = new URL("/assets/img/og.jpg", Astro.site).href;

const currentSlug = pathname.replace(/^\/articles\/?/, "").replace(/\/$/, "");
const isArticle = currentSlug !== "" && articles.some((a) => a.slug === currentSlug);

const breadcrumbLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Mockingbird", item: new URL("/", Astro.site).href },
    { "@type": "ListItem", position: 2, name: "Статьи", item: new URL("/articles/", Astro.site).href },
    ...(isArticle
      ? [{ "@type": "ListItem", position: 3, name: title }]
      : []),
  ],
};

const extraLd = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
---

<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title} — Mockingbird</title>
  {description && <meta name="description" content={description} />}
  <meta name="robots" content="index, follow, max-image-preview:large" />
  <link rel="canonical" href={canonical} />
  <link rel="icon" type="image/png" href="/assets/img/favicon.png" />

  <meta property="og:type" content={isArticle ? "article" : "website"} />
  <meta property="og:site_name" content="Mockingbird" />
  <meta property="og:title" content={title} />
  {description && <meta property="og:description" content={description} />}
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:locale" content="ru_RU" />
  {date && <meta property="article:published_time" content={date} />}

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  {description && <meta name="twitter:description" content={description} />}
  <meta name="twitter:image" content={ogImage} />

  <link rel="preload" href="/assets/fonts/Inter-400-cyrillic.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/assets/fonts/Kholodos.woff2" as="font" type="font/woff2" crossorigin />

  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />
  {extraLd.map((ld) => <script type="application/ld+json" set:html={JSON.stringify(ld)} />)}
</head>
<body>
  <header class="art-header">
    <a class="art-header__brand" href="/">
      <img src="/assets/img/logo.png" alt="" />
      <span class="art-header__name"><b>M</b>ockingbird</span>
    </a>
    <span class="art-header__docs">статьи</span>
    <nav class="art-header__nav">
      <a class="art-header__link" href="/">на главную ↗</a>
      <a class="art-header__link" href="/docs/">docs ↗</a>
      <a class="art-header__cta" href="/articles/">все статьи</a>
    </nav>
  </header>

  <div class="art-shell">
    <aside class="art-nav">
      <span class="art-nav__title">Статьи</span>
      <ul>
        {articles.map((a) => (
          <li>
            <a href={articlePath(a.slug)} class={isArticle && a.slug === currentSlug ? "is-active" : ""}>{a.title}</a>
          </li>
        ))}
      </ul>
    </aside>

    <main class="art-content">
      <slot />

      <footer class="art-footer">
        <span>© {new Date().getFullYear()} mockingbird</span>
        <span>
          <a href="https://github.com/Mockingbird-go-on/mockingbird/releases">релизы</a> ·
          <a href="https://t.me/MOCKINGBird_release">telegram</a>
        </span>
      </footer>
    </main>
  </div>
</body>
</html>
